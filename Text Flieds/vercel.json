{
  "redirects": [
    { "source": "/", "destination": "/textfields.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/webview", "destination": "/api/webview" },
    { "source": "/webview/:path*", "destination": "/api/webview/:path*" },
    { "source": "/guardian", "destination": "/api/guardian" },
    { "source": "/guardian/:path*", "destination": "/api/guardian/:path*" },
    { "source": "/bbc", "destination": "/api/bbc" },
    { "source": "/bbc/:path*", "destination": "/api/bbc/:path*" },
    { "source": "/__lan.json", "destination": "/api/lan" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 20
    }
  }
}
